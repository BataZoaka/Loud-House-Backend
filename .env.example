# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call this API (your Next.js app).
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# These credentials match docker-compose.yml. If you change one, change both.
# Using your own Postgres instead? Substitute your user:password@host:port/db.
DATABASE_URL=postgresql://loudhouse:loudhouse@localhost:5432/loudhouse?schema=public

# ---------------------------------------------------------------------------
# Auth (Sign-In-With-Ethereum)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d
# Must match the domain your frontend is served from, or SIWE verification
# fails. This is what stops a phishing site reusing signatures against us.
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_STATEMENT=Sign in to The Loud House.

# ---------------------------------------------------------------------------
# Chain — Robinhood Chain
# ---------------------------------------------------------------------------
# 4663  = Robinhood Chain mainnet   (explorer: https://robinhoodchain.blockscout.com)
# 46630 = Robinhood Chain testnet   (explorer: https://explorer.testnet.chain.robinhood.com)
#
# Other EVM chains, if you ever need them: 1 Ethereum, 8453 Base,
# 137 Polygon, 42161 Arbitrum, 11155111 Sepolia.
#
# An unrecognised CHAIN_ID is a hard boot failure, not a silent fallback —
# see src/modules/chain/ownership.service.ts for why that matters.
CHAIN_ID=4663

# Public endpoint. Fine to start with; move to a dedicated provider before
# launch, since public RPCs rate-limit and ownership checks run on every stake.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Testnet:  https://rpc.testnet.chain.robinhood.com

# The Loud House ERC-721 contract.
NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Indexer / explorer API (server-side only)
# ---------------------------------------------------------------------------
# The collection lives on Robinhood Chain (4663), which OpenSea does not index —
# so there is no OpenSea API to sync from, whatever the collection is listed on
# elsewhere. Blockscout is the explorer for this chain and exposes a public REST
# API, which is what the indexer should read token holders and metadata from.
#
#   Holders:   {BLOCKSCOUT_API_URL}/v2/tokens/{contract}/holders
#   Instances: {BLOCKSCOUT_API_URL}/v2/tokens/{contract}/instances
#
# No key required for public Blockscout instances.
BLOCKSCOUT_API_URL=https://robinhoodchain.blockscout.com/api
# Testnet: https://explorer.testnet.chain.robinhood.com/api


# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
# The designs say "Demo only — no wallet or contract is connected yet".
# With this true, staking accepts any tenant without proving on-chain
# ownership. MUST be false in production.
DEMO_MODE=true
